        {
          "name": "Search by Location",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Basic validation + helpful logging for debugging 5xx responses",
                  "let json;",
                  "try {",
                  "  json = pm.response.json();",
                  "  console.log('Search by Location response JSON:', json);",
                  "} catch (e) {",
                  "  console.log('Search by Location response (non-JSON):', pm.response.text());",
                  "}",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('success === true (if present)', function () {",
                  "  if (json && Object.prototype.hasOwnProperty.call(json, 'success')) {",
                  "    pm.expect(json.success, 'response.success').to.eql(true);",
                  "  } else {",
                  "    pm.expect(true).to.eql(true); // no-op if field not present",
                  "  }",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "packages": {},
                "type": "text/javascript"
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
