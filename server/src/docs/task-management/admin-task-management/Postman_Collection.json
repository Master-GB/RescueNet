        },
        {
          "name": "Update Help Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\",\n  \"adminNotes\": \"NGO team is on-site. Monitoring closely.\",\n  \"publishedToSocial\": true\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/help-requests/{{helpRequestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "help-requests", "{{helpRequestId}}"]
            },
            "description": "Updates admin-controlled fields. Do NOT send `assignedTo` or `assignments` — use the dedicated assign/unassign endpoints instead.\n\nAllowed status values: `pending`, `verified`, `assigned`, `in-progress`, `resolved`, `rejected`.\n\nSetting `status: 'resolved'` auto-sets `resolvedAt`."
          },
          "response": [
            {
              "name": "200 OK — Updated",
              "originalRequest": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"in-progress\",\n  \"adminNotes\": \"NGO team is on-site. Monitoring closely.\",\n  \"publishedToSocial\": true\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/admin/help-requests/{{helpRequestId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "admin", "help-requests", "{{helpRequestId}}"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Help request updated successfully\",\n  \"data\": {\n    \"_id\": \"665f1a2b3c4d5e6f7a8b9c0d\",\n    \"status\": \"in-progress\",\n    \"adminNotes\": \"NGO team is on-site. Monitoring closely.\",\n    \"publishedToSocial\": true\n  }\n}"
            },
            {
              "name": "400 — Assignment fields blocked",
              "originalRequest": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"assignments\": []\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/admin/help-requests/{{helpRequestId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "admin", "help-requests", "{{helpRequestId}}"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Use the assign/unassign endpoints to modify assignments\"\n}"
            }
          ]
