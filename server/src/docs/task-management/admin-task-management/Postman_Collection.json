{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "RescueNet — Admin Task Management",
    "description": "Admin-only endpoints for managing help request lifecycle and NGO profiles in RescueNet.\n\n**Setup:**\n1. Create an environment with the variables listed below.\n2. Log in via `POST /api/auth/login` and paste the returned token into the `token` variable.\n3. Run requests in order or independently.\n\n**Required Environment Variables:**\n- `baseUrl` — e.g. `http://localhost:5000`\n- `token` — JWT from admin login\n- `helpRequestId` — ObjectId of a help request to test against\n- `ngoId` — ObjectId of an NGO profile to test against",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Base URL of the RescueNet API server"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token obtained from POST /api/auth/login"
    },
    {
      "key": "helpRequestId",
      "value": "665f1a2b3c4d5e6f7a8b9c0d",
      "type": "string",
      "description": "Sample help request ObjectId — replace with a real one"
    },
    {
      "key": "ngoId",
      "value": "665a0b1c2d3e4f5a6b7c8d9e",
      "type": "string",
      "description": "Sample NGO profile ObjectId — replace with a real one"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Help Request Management",
      "description": "Endpoints for triaging, verifying, assigning, and resolving citizen help requests.",
      "item": [
        {
          "name": "Get All Help Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/help-requests?status=pending&urgency=high&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "help-requests"],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Filter by status: pending | verified | assigned | in-progress | resolved | rejected"
                },
                {
                  "key": "urgency",
                  "value": "high",
                  "description": "Filter by urgency: low | medium | high"
                },
                {
                  "key": "disasterType",
                  "value": "flood",
                  "description": "Filter by disaster type: flood | tsunami | landslide | cyclone | other",
                  "disabled": true
                },
                {
                  "key": "assignedTo",
                  "value": "unassigned",
                  "description": "Filter by NGO ObjectId or 'unassigned' for unassigned requests",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Results per page (default: 20)"
                }
              ]
            },
            "description": "Returns a paginated, filterable list of all help requests. Supports filtering by status, disasterType, urgency, and assignedTo NGO."
          },
          "response": [
            {
              "name": "200 OK — Paginated list",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/admin/help-requests?status=pending&urgency=high&page=1&limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "admin", "help-requests"],
                  "query": [
                    { "key": "status", "value": "pending" },
                    { "key": "urgency", "value": "high" },
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "10" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"_id\": \"665f1a2b3c4d5e6f7a8b9c0d\",\n      \"name\": \"John Silva\",\n      \"location\": \"Colombo, Sri Lanka\",\n      \"contactNumber\": \"+94771234567\",\n      \"realLocation\": \"6.9271,79.8612\",\n      \"disasterType\": \"flood\",\n      \"message\": \"Water level rising, need immediate evacuation.\",\n      \"urgency\": \"high\",\n      \"status\": \"pending\",\n      \"assignments\": [],\n      \"publishedToSocial\": false,\n      \"createdAt\": \"2026-02-20T08:30:00.000Z\",\n      \"updatedAt\": \"2026-02-20T08:30:00.000Z\"\n    }\n  ],\n  \"pagination\": {\n    \"total\": 54,\n    \"page\": 1,\n    \"limit\": 10,\n    \"totalPages\": 6\n  }\n}"
            }
          ]
        },
