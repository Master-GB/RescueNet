        {
          "name": "Resolve Help Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminNotes\": \"All affected residents evacuated. Situation stable.\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/help-requests/{{helpRequestId}}/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "help-requests", "{{helpRequestId}}", "resolve"]
            },
            "description": "Marks a help request as resolved. Sets resolvedAt to now. Increments completedTasks on all NGOs whose assignment status is 'completed'. The adminNotes field is optional."
          },
          "response": [
            {
              "name": "200 OK — Resolved",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"adminNotes\": \"All affected residents evacuated. Situation stable.\"\n}"
