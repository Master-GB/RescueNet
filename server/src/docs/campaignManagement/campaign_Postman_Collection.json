{
  "info": {
    "name": "RescueNet - Donations & Campaign Management",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Postman collection for RescueNet Donations & Campaign Management APIs. Includes campaign CRUD (NGO), donation submission (Citizen/Volunteer) with proof image upload, and donation verification (NGO). Run the Login requests first so the access_token cookie is stored by Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
