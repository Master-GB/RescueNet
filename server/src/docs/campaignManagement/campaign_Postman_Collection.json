    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "campaignId",
      "value": ""
    },
    {
      "key": "donationId",
      "value": ""
    },
    {
      "key": "ngoEmail",
      "value": "ngo@rescuenet.org"
    },
    {
      "key": "ngoPassword",
      "value": "12345678"
    },
    {
      "key": "citizenEmail",
      "value": "citizen@example.com"
    },
    {
      "key": "citizenPassword",
      "value": "12345678"
    }
