    {
      "name": "Campaigns",
      "item": [
        {
          "name": "Create Campaign (NGO only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/campaigns/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Southern Province Flood Relief\",\n  \"description\": \"Raising funds and supplies for flood-affected families in Matara and Galle districts. All contributions will go directly to affected communities.\",\n  \"targetAmount\": 500000,\n  \"bankDetails\": {\n    \"accountName\": \"RescueNet Relief Fund\",\n    \"accountNumber\": \"1234567890\",\n    \"bankName\": \"Bank of Ceylon\",\n    \"branchName\": \"Colombo Main\"\n  },\n  \"acceptedItems\": [\"Clothes\", \"Dry Rations\", \"Water Bottles\", \"Blankets\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create returns 201', function () {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "let data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "pm.test('Response has success true', function () {",
                  "  pm.expect(data.success).to.be.true;",
                  "});",
                  "const id = data?.campaign?._id || data?.campaign?.id;",
                  "if (id) pm.collectionVariables.set('campaignId', id);",
                  "pm.test('campaignId stored', function () {",
                  "  pm.expect(pm.collectionVariables.get('campaignId')).to.not.be.empty;",
                  "});",
                  "pm.test('raisedAmount defaults to 0', function () {",
                  "  pm.expect(data.campaign.raisedAmount).to.equal(0);",
                  "});",
                  "pm.test('status defaults to Active', function () {",
                  "  pm.expect(data.campaign.status).to.equal('Active');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Campaign - Missing Required Fields (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
