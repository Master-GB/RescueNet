  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as NGO - sets cookie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ngoEmail}}\",\n  \"password\": \"{{ngoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200/201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                  "});",
                  "pm.test('Set-Cookie header exists', function () {",
                  "  pm.expect(pm.response.headers.has('Set-Cookie')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Citizen - sets cookie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{citizenEmail}}\",\n  \"password\": \"{{citizenPassword}}\"\n}"
            }
          },
          "event": [
            {
