    {
      "name": "Donations",
      "description": "Login as a Citizen or Volunteer before running these requests.",
      "item": [
        {
          "name": "Submit Money Donation with Proof Image (Citizen/Volunteer)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/donations/submit",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "campaignId",
                  "value": "{{campaignId}}",
                  "type": "text"
                },
                {
                  "key": "donationType",
                  "value": "Money",
                  "type": "text"
                },
                {
                  "key": "declaredAmount",
                  "value": "5000",
                  "type": "text"
                },
                {
                  "key": "donorMessage",
                  "value": "Stay strong! Hope this helps.",
                  "type": "text"
                },
                {
                  "key": "proofImage",
                  "type": "file",
                  "src": "",
                  "description": "Select a JPEG/PNG image of the bank transfer slip"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Submit returns 201', function () {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "let data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "pm.test('Response has success true', function () {",
                  "  pm.expect(data.success).to.be.true;",
                  "});",
                  "pm.test('Donation status is Pending', function () {",
                  "  pm.expect(data.donation.status).to.equal('Pending');",
                  "});",
                  "pm.test('proofImageUrl is a Cloudinary URL', function () {",
                  "  pm.expect(data.donation.proofImageUrl).to.include('cloudinary');",
                  "});",
                  "const id = data?.donation?._id || data?.donation?.id;",
                  "if (id) pm.collectionVariables.set('donationId', id);",
                  "pm.test('donationId stored', function () {",
                  "  pm.expect(pm.collectionVariables.get('donationId')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
