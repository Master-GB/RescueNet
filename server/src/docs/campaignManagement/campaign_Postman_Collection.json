            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get active returns 200', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "let data = pm.response.json();",
                  "pm.test('Response has campaigns array', function () {",
                  "  pm.expect(data.campaigns).to.be.an('array');",
                  "});",
                  "pm.test('All campaigns have Active status', function () {",
                  "  data.campaigns.forEach(c => {",
                  "    pm.expect(c.status).to.equal('Active');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
