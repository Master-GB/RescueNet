{
  "info": {
    "name": "RescueNet - Disaster Module (USGS + FIRMS + GDACS + ReliefWeb)",
    "description": "Disaster aggregation endpoints for map layers and heatmap-ready points.\n\nCovers:\n- /api/disasters/map (GeoJSON FeatureCollection)\n- /api/disasters/heatmap (heatmap-ready points)\n- /api/disasters/updates (ReliefWeb updates)\n\nIncludes example requests for each type: EARTHQUAKE, FIRE, FLOOD, TSUNAMI, CYCLONE, STORM, VOLCANO, DROUGHT.\n\nNote: ReliefWeb may require an approved appname.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "start",
      "value": "2026-02-01"
    },
    {
      "key": "end",
      "value": "2026-02-19"
    },
    {
      "key": "bboxWorld",
      "value": "-180,-90,180,90"
    },
    {
      "key": "bboxSriLanka",
      "value": "79.5,5.7,82.1,10.0"
    },
    {
      "key": "minmag",
      "value": "2.5"
    },
    {
      "key": "firmsDays",
      "value": "3"
    },
    {
      "key": "limit",
      "value": "20"
    },
    {
      "key": "q",
      "value": "Sri Lanka"
    }
  ],
  "item": [
    {
      "name": "A) Disaster Map (GeoJSON)",
      "item": [
        {
          "name": "Map - EARTHQUAKE (USGS)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/disasters/map?start={start}&end={end}&types=EARTHQUAKE&bbox={{bboxSriLanka}}&minmag={minmag}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "disasters",
                "map"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "{{start}}"
                },
                {
                  "key": "end",
                  "value": "{{end}}"
                },
                {
                  "key": "types",
                  "value": "EARTHQUAKE"
                },
                {
                  "key": "bbox",
                  "value": "{{bboxSriLanka}}"
                },
                {
                  "key": "minmag",
                  "value": "{{minmag}}"
                }
              ]
            },
            "description": "Returns GeoJSON FeatureCollection for type=EARTHQUAKE. Use bboxSriLanka or bboxWorld."
          }
        },
        {
